<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.example.nodediary.mapper.UserMapper">
<insert id="insertUser" useGeneratedKeys="true" keyProperty="id">
    insert into
    user(id,username,password,nickname,avatar_url,created_at,gender)
    values(#{id},#{username},#{password},#{nickname},#{avatarUrl},#{createdAt},#{gender})
</insert>

    <update id="updateUser" parameterType="org.example.nodediary.pojo.User">
        update user
        <set>
            <if test="nickname != null and nickname != ''">
                nickname = #{nickname},
            </if>
            <if test="avatarUrl != null and avatarUrl != ''">
                avatar_url = #{avatarUrl},
            </if>

        </set>
        where id = #{id}
    </update>
</mapper>